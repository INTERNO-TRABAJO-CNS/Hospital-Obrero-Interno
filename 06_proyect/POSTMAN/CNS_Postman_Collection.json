{
  "info": {
    "name": "CNS Hospital Obrero - API (simulacion)",
    "description": "Rutas tomadas de las tarjetas T100. Para simular a cada usuario cambia las variables de la coleccion: usuario_id, rol (PACIENTE, MEDICO, ENFERMERIA o ADMINISTRADOR) y persona_id. Los cuerpos (body) estan vacios: se completan cuando cada endpoint exista.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario_id",
      "value": "1"
    },
    {
      "key": "rol",
      "value": "PACIENTE"
    },
    {
      "key": "persona_id",
      "value": "1"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// TEMPORAL: el backend lee el usuario de estos headers hasta que exista el login real.",
          "pm.request.headers.upsert({ key: 'X-Usuario-Id', value: pm.variables.get('usuario_id') });",
          "pm.request.headers.upsert({ key: 'X-Rol', value: pm.variables.get('rol') });",
          "pm.request.headers.upsert({ key: 'X-Persona-Id', value: pm.variables.get('persona_id') });"
        ]
      }
    }
  ],
