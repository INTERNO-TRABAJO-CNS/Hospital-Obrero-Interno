{
  "info": {
    "name": "CNS Hospital Obrero - API (simulacion)",
    "description": "Rutas tomadas de las tarjetas T100. Desde el 13/11/2026 el backend usa login con token (Authorization: Bearer). Primero ejecuta '00 Base / Login (guarda el token)' con el usuario que quieras simular: el token queda en la variable {{token}} y toda la coleccion lo envia. Las cabeceras X-Usuario-Id / X-Rol / X-Persona-Id ya no se aceptan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario",
      "value": "admin"
    },
    {
      "key": "clave",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "00 Base",
      "item": [
        {
          "name": "Login (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }",
                  "pm.test('login correcto', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"usuario\":\"{{usuario}}\",\"clave\":\"{{clave}}\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Cerrar sesion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Salud del servidor",
          "request": {
            "method": "GET",
            "header": [],
