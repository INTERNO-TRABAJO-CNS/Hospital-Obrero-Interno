@startuml CU-07_RegistrarCitaConfirmada
' Caso de uso CU-07: Registrar cita confirmada
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-07 · RN-07 · RN-08 · RN-14 · CU-06 · CU-16
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
title CU-07: Registrar cita confirmada\nDiagrama de actividad
|Asignación / Enfermería|
start
:Recibe asignación validada y datos de la cita;
:Confirma registrar la cita cuando corresponda;
|Validación (CU-06)|
:Verifica que médico, horario y consultorio sigan libres;
if (¿Asignación aún válida?) then (Sí)
  ' Camino principal
else (No / 2a)
  :No registra, solicita nueva validación o asignación [2a];
  stop
endif
|Sistema CNS|
if (¿Datos obligatorios completos?) then (Sí)
  ' Camino principal
else (No / 3a)
  :No confirma hasta completar datos [3a];
  stop
endif
:Registra paciente, especialidad, médico, fecha, hora y consultorio;
:Marca estado inicial programada y confirma cita;
|Notificación (CU-16)|
:Genera notificación correspondiente (CU-16);
stop
@enduml
