@startuml CU-04_SolicitarCitaMedica
' Caso de uso CU-04: Solicitar cita médica
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-04 · RN-01 · RN-03 · CU-05
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
' Modificado 04/11/2026: ver 06_proyect/CAMBIOS_04-11-2026.md
title CU-04: Solicitar cita médica\nDiagrama de actividad
|Paciente|
start
:Ingresa a la opción solicitar cita;
|Aplicación Flutter|
:Muestra las especialidades Consultorio Familiar, Odontología y Pediatría;
|Paciente|
:Selecciona la especialidad;
|Sistema CNS (Java)|
if (¿Especialidad válida?) then (Sí)
  ' Camino principal
else (No / 2a)
  :Solicita seleccionar una especialidad válida [2a];
  stop
endif
|Paciente|
:Selecciona el día de atención;
|Sistema CNS (Java)|
if (¿Día hábil dentro de los 15 días hábiles y sin otra cita ese día?) then (Sí)
  ' Camino principal
else (No / 3a)
  :No permite confirmar y solicita elegir otro día [3a];
  stop
endif
|Paciente|
:Confirma la solicitud sin elegir médico ni hora;
|Sistema CNS (Java)|
:Registra la solicitud en la cola con su orden de llegada;
|Asignación (CU-05)|
:Procesa la solicitud en orden de llegada;
if (¿Hay cupo para el día solicitado?) then (Sí)
  |Sistema CNS (Java)|
  :Muestra la cita asignada con ficha, médico, hora y consultorio;
else (No / 5a)
  |Sistema CNS (Java)|
  :Muestra NO HAY CUPOS y deja la solicitud EN_ESPERA para el siguiente día hábil [5a];
endif
stop
@enduml
