@startuml CU-09_ConsultarCitasRegistradas
' Caso de uso CU-09: Consultar citas registradas
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-09 · RN-16 · RN-20
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
title CU-09: Consultar citas registradas\nDiagrama de actividad
|Enfermería / Admisión|
start
:Abre el módulo de consulta de citas;
|Interfaz de consultas|
:Presenta criterios de búsqueda disponibles;
|Enfermería / Admisión|
:Elige paciente, médico, fecha, estado o consultorio;
|Sistema CNS / citas|
if (¿Criterio completo y válido?) then (Sí)
  ' Camino principal
else (No / 2a)
  :Solicita corregir el criterio de búsqueda [2a];
  stop
endif
|Enfermería / Admisión|
:Ejecuta la búsqueda;
|Sistema CNS / citas|
:Busca citas según el filtro autorizado;
if (¿Se encontraron coincidencias?) then (Sí)
  ' Camino principal
else (No / 3a)
  :Informa que no se encontraron citas [3a];
  stop
endif
|Interfaz de consultas|
:Presenta los resultados al personal autorizado;
|Enfermería / Admisión|
:Revisa las citas registradas;
stop
@enduml
