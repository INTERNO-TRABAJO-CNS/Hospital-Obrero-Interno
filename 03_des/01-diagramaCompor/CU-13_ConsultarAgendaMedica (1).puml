@startuml CU-13_ConsultarAgendaMedica
' Caso de uso CU-13: Consultar agenda médica
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-13 · RN-18 · RN-20
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
title CU-13: Consultar agenda médica\nDiagrama de actividad
|Médico|
start
:Abre la opción de agenda médica;
|Sistema CNS / agendas|
if (¿Usuario autenticado como médico?) then (Sí)
  ' Camino principal
else (No / 1a)
  :Impide acceso a agenda médica restringida [1a];
  stop
endif
|Médico|
:Elige vista diaria o semanal;
|Interfaz de agenda|
:Envía el período de consulta;
|Sistema CNS / agendas|
:Busca citas asignadas al médico autenticado;
if (¿Existen citas para el período?) then (Sí)
  ' Camino principal
else (No / 3a)
  :Informa que no hay citas programadas [3a];
  stop
endif
|Interfaz de agenda|
:Muestra las citas en la vista solicitada;
|Médico|
:Revisa su agenda sin modificar registros;
stop
@enduml
