@startuml CU-17_GenerarRecordatorioCita
' Caso de uso CU-17: Generar recordatorio de cita
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-17 · RN-15
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
title CU-17: Generar recordatorio de cita\nDiagrama de actividad
|Proceso automático|
start
:Evalúa citas próximas a su fecha programada;
|Sistema CNS / citas|
if (¿Dentro del período configurado?) then (Sí)
  ' Camino principal
else (No / 1a)
  :No genera recordatorio todavía [1a];
  stop
endif
:Consulta estado e información actual de la cita;
if (¿La cita continúa programada y vigente?) then (Sí)
  ' Camino principal
else (No / 2a)
  :No genera aviso con datos cancelados o antiguos [2a];
  stop
endif
|Generador de recordatorios|
:Prepara recordatorio con información vigente;
:Genera recordatorio de la cita;
|Paciente|
:Recibe o consulta recordatorio por mecanismo por definir;
stop
@enduml
