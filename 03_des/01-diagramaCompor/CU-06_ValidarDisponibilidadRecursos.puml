@startuml CU-06_ValidarDisponibilidadRecursos
' Caso de uso CU-06: Validar disponibilidad de recursos
' Fuentes: Especificación de casos de uso CNS y Modelo del Negocio del Hospital Obrero
' Referencias: RF-06 · RN-05 · RN-06 · RN-07 · RN-21
' Los elementos marcados como pendientes NO son reglas implementadas.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam ArrowColor #234C79
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #35628E
  FontColor #152536
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #35628E
  ArrowColor #234C79
  StartColor #35628E
  EndColor #35628E
}
title CU-06: Validar disponibilidad de recursos\nDiagrama de actividad
|Proceso solicitante|
start
:Envía candidato: médico, fecha, hora y consultorio;
|Validador CNS (CU-06)|
:Consulta disponibilidad actual del médico y horario;
|Agenda médica|
if (¿Médico y horario disponibles?) then (Sí)
  ' Camino principal
else (No / 2a)
  :Marca la combinación como no disponible [2a];
  stop
endif
|Validador CNS (CU-06)|
:Consulta disponibilidad del consultorio;
|Consultorios / citas|
if (¿Consultorio disponible?) then (Sí)
  ' Camino principal
else (No / 3a)
  :Marca la combinación como no disponible [3a];
  stop
endif
|Validador CNS (CU-06)|
:Verifica otras citas para evitar superposición;
|Consultorios / citas|
if (¿Hay conflicto simultáneo?) then (No)
  ' Camino principal
else (Sí / 4a)
  :Permite una única confirmación, rechaza la duplicada [4a];
  stop
endif
|Validador CNS (CU-06)|
:Devuelve resultado de disponibilidad válida;
|Proceso solicitante|
:Continúa asignación, confirmación o reprogramación;
stop
@enduml
