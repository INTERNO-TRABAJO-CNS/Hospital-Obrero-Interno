@startuml CU-16_GenerarNotificaciondeCita
' Diagrama individual de caso de uso CU-16 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-16: Generar Notificación de Cita

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-16\nGenerar Notificación de Cita" as CU16
  usecase "CU-07\nRegistrar Cita Confirmada" as CU07
  usecase "CU-11\nCancelar Cita" as CU11
}

note left of CU16
  Proceso automático interno del sistema.
  No existe actor humano iniciador.
end note
CU07 ..> CU16 : <<include>>
CU11 ..> CU16 : <<include>>
note bottom of CU16
  Se activa por cita registrada, modificada o cancelada; canal de envío aún no definido.
end note

@enduml
