@startuml CU-17_GenerarRecordatoriodeCita
' Diagrama individual de caso de uso CU-17 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-17: Generar Recordatorio de Cita

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-17\nGenerar Recordatorio de Cita" as CU17
}

note left of CU17
  Proceso automático interno del sistema.
  No existe actor humano iniciador.
end note
note bottom of CU17
  La cita debe seguir programada; anticipación y canal del recordatorio sin definir.
end note

@enduml
