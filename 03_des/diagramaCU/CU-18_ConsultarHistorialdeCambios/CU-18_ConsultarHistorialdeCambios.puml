@startuml CU-18_ConsultarHistorialdeCambios
' Diagrama individual de caso de uso CU-18 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-18: Consultar Historial de Cambios

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-18\nConsultar Historial de Cambios" as CU18
}

actor "Enfermería / Admisión" as ACTOR1
ACTOR1 --> CU18
actor "Administrador" as ACTOR2
ACTOR2 --> CU18
note bottom of CU18
  Consultar qué cambió, quién lo realizó y cuándo, sin modificar el historial.
end note

@enduml
