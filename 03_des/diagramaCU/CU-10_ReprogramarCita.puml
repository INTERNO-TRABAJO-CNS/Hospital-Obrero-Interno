@startuml CU-10_ReprogramarCita
' Diagrama individual de caso de uso CU-10 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-10: Reprogramar Cita

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-10\nReprogramar Cita" as CU10
  usecase "CU-06\nValidar Disponibilidad de Recursos" as CU06
  usecase "CU-16\nGenerar Notificación de Cita" as CU16
}

actor "Enfermería / Admisión" as ACTOR1
ACTOR1 --> CU10
CU10 ..> CU06 : <<include>>
CU10 ..> CU16 : <<include>>
note bottom of CU10
  Revalidar recursos antes de guardar la reprogramación y notificar al paciente.
end note

@enduml
