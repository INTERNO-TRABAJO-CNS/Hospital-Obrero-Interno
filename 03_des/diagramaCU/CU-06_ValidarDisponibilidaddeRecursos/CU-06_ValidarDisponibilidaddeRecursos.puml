@startuml CU-06_ValidarDisponibilidaddeRecursos
' Diagrama individual de caso de uso CU-06 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-06: Validar Disponibilidad de Recursos

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-06\nValidar Disponibilidad de Recursos" as CU06
  usecase "CU-05\nAsignar Cita Automáticamente" as CU05
  usecase "CU-10\nReprogramar Cita" as CU10
}

note left of CU06
  Proceso automático interno del sistema.
  No existe actor humano iniciador.
end note
CU05 ..> CU06 : <<include>>
CU10 ..> CU06 : <<include>>
note bottom of CU06
  Verificar médico, fecha, hora y consultorio sin solapamientos ni doble asignación.
end note

@enduml
