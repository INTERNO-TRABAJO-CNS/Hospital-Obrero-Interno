@startuml CU-14_ConsultarInformacionPermitidadelPaciente
' Diagrama individual de caso de uso CU-14 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-14: Consultar Información Permitida del Paciente

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-14\nConsultar Información Permitida del Paciente" as CU14
}

actor "Médico" as ACTOR1
ACTOR1 --> CU14
note bottom of CU14
  Mostrar información básica e historial permitido de pacientes con cita asignada.
end note

@enduml
