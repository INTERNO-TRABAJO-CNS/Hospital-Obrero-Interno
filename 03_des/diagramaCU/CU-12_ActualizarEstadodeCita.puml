@startuml CU-12_ActualizarEstadodeCita
' Diagrama individual de caso de uso CU-12 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-12: Actualizar Estado de Cita

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-12\nActualizar Estado de Cita" as CU12
}

actor "Médico" as ACTOR1
ACTOR1 --> CU12
actor "Enfermería autorizada" as ACTOR2
ACTOR2 --> CU12
note bottom of CU12
  Actualizar solo estados permitidos; conservar la operación para seguimiento.
end note

@enduml
