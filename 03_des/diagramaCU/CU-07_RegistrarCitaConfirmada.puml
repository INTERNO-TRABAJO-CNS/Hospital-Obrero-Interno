@startuml CU-07_RegistrarCitaConfirmada
' Diagrama individual de caso de uso CU-07 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-07: Registrar Cita Confirmada

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-07\nRegistrar Cita Confirmada" as CU07
  usecase "CU-06\nValidar Disponibilidad de Recursos" as CU06
  usecase "CU-16\nGenerar Notificación de Cita" as CU16
}

actor "Enfermería / Admisión" as ACTOR1
ACTOR1 --> CU07
CU07 ..> CU06 : <<include>>
CU07 ..> CU16 : <<include>>
note bottom of CU07
  Registrar solo asignaciones validadas y generar notificación tras confirmar la cita.
end note

@enduml
