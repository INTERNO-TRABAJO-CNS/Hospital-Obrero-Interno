  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-13: Consultar Agenda Médica

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-13\nConsultar Agenda Médica" as CU13
}

actor "Médico" as ACTOR1
ACTOR1 --> CU13
note bottom of CU13
  Citas del día actual y selector de otras fechas, exclusivamente del médico autenticado.
