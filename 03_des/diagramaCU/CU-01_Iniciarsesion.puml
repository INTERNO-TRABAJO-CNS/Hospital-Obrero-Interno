@startuml CU-01_Iniciarsesion
' Diagrama individual de caso de uso CU-01 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-01: Iniciar sesión

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-01\nIniciar sesión" as CU01
}

actor "Paciente" as ACTOR1
ACTOR1 --> CU01
actor "Enfermería / Admisión" as ACTOR2
ACTOR2 --> CU01
actor "Médico" as ACTOR3
ACTOR3 --> CU01
actor "Administrador" as ACTOR4
ACTOR4 --> CU01
note bottom of CU01
  Acceso condicionado por credenciales válidas y permisos del rol (RNF-01, RNF-02).
end note

@enduml
