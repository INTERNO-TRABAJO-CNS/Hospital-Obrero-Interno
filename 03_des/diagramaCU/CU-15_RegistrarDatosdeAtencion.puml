@startuml CU-15_RegistrarDatosdeAtencion
' Diagrama individual de caso de uso CU-15 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-15: Registrar Datos de Atención

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-15\nRegistrar Datos de Atención" as CU15
  usecase "CU-12\nActualizar Estado de Cita" as CU12
}

actor "Médico" as ACTOR1
ACTOR1 --> CU15
actor "Enfermería autorizada" as ACTOR2
ACTOR2 --> CU15
CU12 ..> CU15 : <<extend>>
note bottom of CU15
  Registrar asistencia, tiempo de espera y atención; estado se actualiza cuando corresponda.
end note

@enduml
