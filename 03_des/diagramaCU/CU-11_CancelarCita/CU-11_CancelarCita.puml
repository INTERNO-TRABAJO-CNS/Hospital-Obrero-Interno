@startuml CU-11_CancelarCita
' Diagrama individual de caso de uso CU-11 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-11: Cancelar Cita

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-11\nCancelar Cita" as CU11
  usecase "CU-16\nGenerar Notificación de Cita" as CU16
}

actor "Paciente" as ACTOR1
ACTOR1 --> CU11
actor "Sistema (cancelación automática)" as ACTOR2
ACTOR2 --> CU11
CU11 ..> CU16 : <<include>>
note bottom of CU11
  El paciente cancela o el sistema cancela a los 30 min sin confirmación; la cita se conserva como CANCELADA.
end note

' Modificado 04/11/2026: ver 06_proyect/CAMBIOS_04-11-2026.md
@enduml
