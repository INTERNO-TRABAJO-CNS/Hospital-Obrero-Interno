@startuml CU-04_SolicitarCitaMedica
' Diagrama individual de caso de uso CU-04 — Hospital Obrero CNS
' Fuente: CNS_ CASOS DE USO(1).docx — matriz y especificación de CU
' Issue: T07 - Diagramas de casos de uso
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #2F5D8A
skinparam actor {
  BorderColor #2F5D8A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F5D8A
  ArrowColor #2F5D8A
}
skinparam rectangle {
  BorderColor #2F5D8A
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
title CU-04: Solicitar Cita Médica

rectangle "Sistema de Gestión y Control de Citas Médicas\nHospital Obrero CNS" as CNS {
  usecase "CU-04\nSolicitar Cita Médica" as CU04
  usecase "CU-05\nAsignar Cita Automáticamente" as CU05
}

actor "Paciente" as ACTOR1
ACTOR1 --> CU04
CU04 ..> CU05 : <<invoca>>
note bottom of CU04
  El paciente indica especialidad; no selecciona médico, fecha, hora ni consultorio.
end note

@enduml
